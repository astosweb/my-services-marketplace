# Web marketplace (Next.js BFF → Nest API)
# Production: NEXT_PUBLIC_SITE_URL=https://gobid.ee
#
# LAN: set LAN_LOCAL_IP_ADDRESS in the repo-root `.env`, then `pnpm dev:web`
# (binds 0.0.0.0 and sets site/API public URLs for http://<ip>:3002).

API_URL=http://localhost:3000
COOKIE_SECURE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3000
