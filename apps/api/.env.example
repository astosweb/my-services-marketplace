# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated origins, or * (any). Prefer explicit origins in production.
# Production refuses to boot if CORS_ORIGIN=* .
CORS_ORIGIN="*"

# Auth (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
# Separate secret for private upload signed URLs (required in production)
# UPLOAD_SIGNING_SECRET="another-long-random-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30
# Frontend page that accepts the reset token query parameter
PASSWORD_RESET_URL="http://localhost:3002/reset-password"
# Resend sends password-reset links in production.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Gobid <no-reply@gobid.ee>"

# PostgreSQL — Neon pooled (recommended for API runtime)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct (no PgBouncer) — prefer for prisma db push / schema ops
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Set to false if Prisma/pg SSL validation fails against managed DB certs (forbidden in production)
# DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# Redis — local Docker only (`pnpm --filter @gobid/api docker:up`)
REDIS_URL="redis://localhost:6380"
# Production requires REDIS_URL unless you explicitly allow single-node memory limits:
# RATE_LIMIT_ALLOW_MEMORY="true"

# DigitalOcean Spaces (S3-compatible)
# Use the regional endpoint only — do NOT put the bucket in the host
# (e.g. not https://my-bucket.fra1.digitaloceanspaces.com). The SDK adds the bucket.
SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
SPACES_REGION="fra1"
SPACES_BUCKET="gobid"
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
SPACES_CDN_URL="https://gobid.fra1.cdn.digitaloceanspaces.com"
# Only set true after Space/bucket policy allows anonymous GetObject on requests/* and avatars/*.
# Otherwise the API proxies file reads (works with ACL-disabled Spaces).
# SPACES_CDN_PUBLIC="true"

# Upload target: auto (local disk in development), local, or spaces.
# Set to "spaces" when Spaces credentials are configured so uploads hit S3 in development too.
UPLOAD_STORAGE=auto

# Public API base URL for upload links and signed private URLs (required non-localhost in production)
API_PUBLIC_URL="http://127.0.0.1:3000"
# Optional LAN IP — prefer repo-root `.env` LAN_LOCAL_IP_ADDRESS. When set, local API_PUBLIC_URL
# is rewritten to http://<ip>:PORT for device / LAN media access.
# LAN_LOCAL_IP_ADDRESS=

# Apple Push Notifications (optional locally — skips send when unset)
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID="ee.gobid.app"
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_PRIVATE_KEY_PATH="./secrets/AuthKey_XXXX.p8"
# APNS_PRODUCTION="false"
