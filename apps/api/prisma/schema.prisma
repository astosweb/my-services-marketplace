generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstonianCity {
  TALLINN
  TARTU
  PARNU
  NARVA
}

enum ServiceRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobProgressStatus {
  ACCEPTED
  ON_THE_WAY
  STARTED
  PROVIDER_DONE
  OWNER_CONFIRMED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum RequestPricingMode {
  PROVIDER_OFFERS
  OWNER_FIXED_PRICE
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
}

enum NotificationKind {
  NEW_OFFER
  OFFER_ACCEPTED
  OFFER_DECLINED
  NEW_MESSAGE
  JOB_COMPLETED
  REVIEW
  PREMIUM_BOOST
  PAYMENT_RECEIVED
  REMINDER
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  displayName         String
  businessName        String?
  preferBusinessName  Boolean  @default(true)
  bio                 String?
  avatarKey    String?
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests         ServiceRequest[] @relation("RequestOwner")
  offers           Offer[]
  sentMessages     Message[]          @relation("MessageSender")
  conversations    ConversationParticipant[]
  notifications    Notification[]
  reviewsGiven     Review[]           @relation("ReviewAuthor")
  reviewsReceived  Review[]           @relation("ReviewSubject")
  deviceTokens     DeviceToken[]
  refreshTokens    RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model Category {
  id     String @id
  name   String
  symbol String

  requests ServiceRequest[]
}

model ServiceRequest {
  id          String               @id @default(cuid())
  ownerId     String
  categoryId  String
  title       String
  description String
  city        EstonianCity
  latitude    Float
  longitude   Float
  location    String
  budgetCents Int?
  budgetLabel String?
  scheduledAt DateTime?
  pricingMode RequestPricingMode  @default(PROVIDER_OFFERS)
  status      ServiceRequestStatus @default(OPEN)
  progressStatus    JobProgressStatus?
  progressUpdatedAt DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  isPremium   Boolean              @default(false)
  viewCount   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  owner        User           @relation("RequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id])
  photos         RequestPhoto[]
  offers         Offer[]
  conversations  Conversation[]
  reviews        Review[]
  progressEvents JobProgressEvent[]

  @@index([city, status])
  @@index([categoryId])
  @@index([ownerId])
}

model JobProgressEvent {
  id        String            @id @default(cuid())
  requestId String
  status    JobProgressStatus
  createdAt DateTime          @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model RequestPhoto {
  id         String   @id @default(cuid())
  requestId  String
  spacesKey  String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Offer {
  id          String      @id @default(cuid())
  requestId   String
  offererId   String
  priceCents  Int?
  message     String?
  status      OfferStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerer User           @relation(fields: [offererId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([offererId])
}

model Conversation {
  id        String   @id @default(cuid())
  requestId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request      ServiceRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([requestId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  isArchived     Boolean   @default(false)
  isPinned       Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id                 String        @id @default(cuid())
  conversationId     String
  senderId           String
  body               String        @default("")
  attachmentKey      String?
  attachmentName     String?
  attachmentMimeType String?
  status             MessageStatus @default(SENT)
  createdAt          DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  kind       NotificationKind
  title      String
  body       String
  contextTag String?
  payload    Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  subjectId String
  requestId String?
  rating    Int
  body      String?
  createdAt DateTime @default(now())

  author  User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([requestId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
