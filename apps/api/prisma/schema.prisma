generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstonianCity {
  TALLINN
  TARTU
  PARNU
  NARVA
}

enum ServiceRequestStatus {
  PENDING_REVIEW
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobProgressStatus {
  ACCEPTED
  ON_THE_WAY
  STARTED
  PROVIDER_DONE
  OWNER_CONFIRMED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum RequestPricingMode {
  PROVIDER_OFFERS
  OWNER_FIXED_PRICE
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
}

enum NotificationKind {
  NEW_OFFER
  OFFER_ACCEPTED
  OFFER_DECLINED
  NEW_MESSAGE
  JOB_COMPLETED
  REVIEW
  PREMIUM_BOOST
  PAYMENT_RECEIVED
  REMINDER
  SYSTEM
  NEW_REQUEST
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_REPLY
  SUPPORT_TICKET_STATUS
  SUPPORT_TICKET_ASSIGNED
  SUPPORT_TICKET_RESOLVED
}

enum SupportTicketCategory {
  BUG
  FEATURE_REQUEST
  PAYMENT
  ACCOUNT
  VERIFICATION
  ABUSE
  OTHER
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  WAITING_FOR_USER
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  REASSIGNED
  MESSAGE_ADDED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  ATTACHMENT_ADDED
  TAG_ADDED
  TAG_REMOVED
  MERGED
  REOPENED
  SLA_BREACHED
  READ
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  displayName         String
  businessName        String?
  preferBusinessName  Boolean  @default(true)
  bio                 String?
  avatarKey    String?
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  role         UserRole @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests         ServiceRequest[] @relation("RequestOwner")
  offers           Offer[]
  sentMessages     Message[]          @relation("MessageSender")
  conversations    ConversationParticipant[]
  notifications    Notification[]
  notificationPreferences NotificationPreference[]
  reviewsGiven     Review[]           @relation("ReviewAuthor")
  reviewsReceived  Review[]           @relation("ReviewSubject")
  deviceTokens     DeviceToken[]
  refreshTokens    RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs        AuditLog[]
  supportTicketsCreated   SupportTicket[]         @relation("SupportTicketCreator")
  supportTicketsAssigned  SupportTicket[]         @relation("SupportTicketAssignee")
  supportMessages         SupportMessage[]        @relation("SupportMessageSender")
  supportInternalNotes    SupportInternalNote[]   @relation("SupportNoteAuthor")
  supportAttachments      SupportAttachment[]     @relation("SupportAttachmentUploader")
  supportStatusChanges    SupportStatusHistory[]  @relation("SupportStatusChanger")
  supportActivities       SupportActivity[]       @relation("SupportActivityActor")
  supportCannedResponses  SupportCannedResponse[] @relation("SupportCannedAuthor")
}

model Category {
  id     String @id
  name   String
  symbol String

  requests                ServiceRequest[]
  notificationPreferences NotificationPreference[]
}

model NotificationPreference {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
}

model ServiceRequest {
  id          String               @id @default(cuid())
  ownerId     String
  categoryId  String
  title       String
  description String
  city        EstonianCity
  latitude    Float
  longitude   Float
  location    String
  budgetCents Int?
  budgetLabel String?
  scheduledAt DateTime?
  pricingMode RequestPricingMode  @default(PROVIDER_OFFERS)
  status      ServiceRequestStatus @default(PENDING_REVIEW)
  progressStatus    JobProgressStatus?
  progressUpdatedAt DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  rejectionReason String?
  isPremium   Boolean              @default(false)
  viewCount   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  owner        User           @relation("RequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id])
  photos         RequestPhoto[]
  offers         Offer[]
  conversations  Conversation[]
  reviews        Review[]
  progressEvents JobProgressEvent[]

  @@index([city, status])
  @@index([categoryId])
  @@index([ownerId])
}

model JobProgressEvent {
  id        String            @id @default(cuid())
  requestId String
  status    JobProgressStatus
  createdAt DateTime          @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model RequestPhoto {
  id         String   @id @default(cuid())
  requestId  String
  spacesKey  String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Offer {
  id          String      @id @default(cuid())
  requestId   String
  offererId   String
  priceCents  Int?
  message     String?
  status      OfferStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerer User           @relation(fields: [offererId], references: [id], onDelete: Cascade)

  @@unique([requestId, offererId])
  @@index([requestId])
  @@index([offererId])
}

model Conversation {
  id        String   @id @default(cuid())
  requestId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request      ServiceRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([requestId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  isArchived     Boolean   @default(false)
  isPinned       Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id                 String        @id @default(cuid())
  conversationId     String
  senderId           String
  body               String        @default("")
  attachmentKey      String?
  attachmentName     String?
  attachmentMimeType String?
  status             MessageStatus @default(SENT)
  createdAt          DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  kind       NotificationKind
  title      String
  body       String
  contextTag String?
  payload    Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  subjectId String
  requestId String?
  rating    Int
  body      String?
  createdAt DateTime @default(now())

  author  User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([authorId, requestId])
  @@index([subjectId])
  @@index([requestId])
}

model DeviceToken {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  platform       String   @default("ios")
  name           String?
  systemVersion  String?
  appVersion     String?
  ipAddress      String?
  userAgent      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([createdAt])
}

model SupportTicket {
  id              String                @id @default(cuid())
  caseNumber      String                @unique
  subject         String
  description     String
  category        SupportTicketCategory
  priority        SupportTicketPriority @default(NORMAL)
  status          SupportTicketStatus   @default(OPEN)
  createdById     String
  assignedAdminId String?
  tags            String[]              @default([])
  mergedIntoId    String?
  firstResponseAt DateTime?
  responseDueAt   DateTime?
  resolveDueAt    DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastMessageAt   DateTime?
  userLastReadAt  DateTime?
  adminLastReadAt DateTime?
  unreadByUser    Int                   @default(0)
  unreadByAdmin   Int                   @default(0)
  appVersion      String?
  platform        String?
  deviceName      String?
  systemVersion   String?
  userAgent       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  createdBy     User                   @relation("SupportTicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedAdmin User?                  @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  mergedInto    SupportTicket?         @relation("SupportTicketMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom    SupportTicket[]        @relation("SupportTicketMerge")
  messages      SupportMessage[]
  attachments   SupportAttachment[]
  internalNotes SupportInternalNote[]
  statusHistory SupportStatusHistory[]
  activities    SupportActivity[]

  @@index([createdById, createdAt])
  @@index([assignedAdminId])
  @@index([status, priority])
  @@index([category])
  @@index([createdAt])
  @@index([caseNumber])
  @@index([lastMessageAt])
}

model SupportMessage {
  id        String    @id @default(cuid())
  ticketId  String
  senderId  String
  body      String    @default("")
  isStaff   Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User                @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([senderId])
}

model SupportAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  messageId  String?
  uploaderId String
  spacesKey  String
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  ticket   SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message  SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User           @relation("SupportAttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
  @@index([uploaderId])
}

model SupportInternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("SupportNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model SupportStatusHistory {
  id          String               @id @default(cuid())
  ticketId    String
  fromStatus  SupportTicketStatus?
  toStatus    SupportTicketStatus
  changedById String
  note        String?
  createdAt   DateTime             @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User          @relation("SupportStatusChanger", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model SupportActivity {
  id        String              @id @default(cuid())
  ticketId  String
  actorId   String
  type      SupportActivityType
  details   Json?
  createdAt DateTime            @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User          @relation("SupportActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([actorId])
}

model SupportCannedResponse {
  id          String                 @id @default(cuid())
  title       String
  body        String
  category    SupportTicketCategory?
  shortcut    String?
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  createdBy User @relation("SupportCannedAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([category])
  @@unique([shortcut])
}

model SupportCaseSequence {
  dateKey   String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}
