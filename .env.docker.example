# Root env for `docker compose` variable substitution (optional).
# Copy to `.env` and adjust secrets for production.

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Required when NODE_ENV=production
# UPLOAD_SIGNING_SECRET=another-long-random-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
PASSWORD_RESET_URL=http://localhost:3002/reset-password
API_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002
SEED_ON_START=true
# Admin/web are served over HTTP in local compose — must be false or browsers drop auth cookies.
COOKIE_SECURE=false
RESEND_API_KEY=
EMAIL_FROM="Bidy <no-reply@example.com>"

# DigitalOcean Spaces (required by docker-compose api service)
# Regional API host only — do not include the bucket in the hostname
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=my-services-marketplace
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# Optional Apple Push Notifications (leave unset to skip APNs in local compose)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.serhatsabuncu.heroApp
# APNS_PRIVATE_KEY=
# APNS_PRODUCTION=false
