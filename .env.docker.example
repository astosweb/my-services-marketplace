# Root env for `docker compose` variable substitution (optional).
# Copy to `.env` and adjust secrets for production.

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:3001
PASSWORD_RESET_URL=http://localhost:3001/reset-password
API_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
SEED_ON_START=true
# Admin is served over HTTP in local compose — must be false or browsers drop auth cookies.
COOKIE_SECURE=false
RESEND_API_KEY=
EMAIL_FROM="Bidy <no-reply@example.com>"

# DigitalOcean Spaces (required by docker-compose api service)
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_BUCKET=my-services-marketplace
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
