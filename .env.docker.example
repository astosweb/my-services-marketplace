# Root env for `docker compose` variable substitution (optional).
# Copy to `.env` and adjust secrets for production.

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:3001
PASSWORD_RESET_URL=http://localhost:3001/reset-password
API_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
SEED_ON_START=true
# Admin is served over HTTP in local compose — must be false or browsers drop auth cookies.
COOKIE_SECURE=false
