{
  "name": "my-services-marketplace",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:api": "pnpm --filter @hero/api dev",
    "dev:admin": "pnpm --filter admin-panel dev",
    "dev:web": "pnpm --filter web dev",
    "build:api": "pnpm --filter @hero/api build",
    "build:admin": "pnpm --filter admin-panel build",
    "build:web": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "update": "pnpm -r up --latest \"!typescript\"",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose up --build -d --force-recreate"
  }
}
