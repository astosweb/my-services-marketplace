{
  "name": "gobid",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "apply:lan": "node scripts/apply-lan.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:admin": "pnpm --filter admin-panel dev",
    "dev:web": "node scripts/dev-web.mjs",
    "build:api": "pnpm --filter @gobid/api build",
    "build:admin": "pnpm --filter admin-panel build",
    "build:web": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "update": "pnpm -r up --latest \"!typescript\"",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose up --build -d --force-recreate"
  }
}
